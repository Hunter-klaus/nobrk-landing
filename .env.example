# NOBRK 환경변수 설정 파일
# 이 파일을 복사해서 .env.local 파일을 만들고, 실제 값을 채워주세요.
# .env.local 파일은 절대 GitHub에 올라가지 않습니다. (자동으로 제외됨)

# =============================================
# Supabase 설정
# Supabase 대시보드 > Settings > API에서 복사하세요
# =============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
